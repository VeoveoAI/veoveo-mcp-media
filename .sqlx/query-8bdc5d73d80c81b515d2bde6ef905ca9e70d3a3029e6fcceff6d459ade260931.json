  "db_name": "PostgreSQL",
  "query": "-- A tenant's daily totals over [$2, $3), in day, principal, kind, phase and currency order.\nSELECT\n    day AS \"day!\",\n    principal AS \"principal!\",\n    kind AS \"kind!\",\n    phase AS \"phase!\",\n    currency AS \"currency!\",\n    quantity::text AS \"quantity!\",\n    amount::text AS \"amount!\",\n    records AS \"records!\"\nFROM usage.daily\nWHERE tenant = $1 AND day >= $2 AND day < $3\nORDER BY day, principal, source, kind, phase, currency\nLIMIT $4\n",
