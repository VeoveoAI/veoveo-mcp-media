{
  "db_name": "PostgreSQL",
  "query": "-- A page of the requests the caller can decide after a cursor's key.\n-- Parameters $1 to $7 are the caller's facts for artifact.effective_level: tenant,\n-- principal, principal key, groups, their roles, labels and time.\nSELECT\n    r.access_request_id AS \"access_request_id: AccessRequestId\",\n    r.artifact_id AS \"artifact_id: ArtifactId\",\n    r.requester,\n    r.level,\n    r.justification,\n    r.state AS \"state: AccessRequestState\",\n    r.decided_by,\n    r.note,\n    r.created_at,\n    r.decided_at\nFROM artifact.access_request AS r\nJOIN artifact.artifact AS a ON a.tenant = r.tenant AND a.artifact_id = r.artifact_id\nWHERE r.tenant = $1\n    AND ($8::text IS NULL OR r.state = $8)\n    AND r.access_request_id < $9\n    AND artifact.effective_level(a, $1, $2, $3, $4, $5, $6, $7) = 3\nORDER BY r.access_request_id DESC\nLIMIT $10\n",
