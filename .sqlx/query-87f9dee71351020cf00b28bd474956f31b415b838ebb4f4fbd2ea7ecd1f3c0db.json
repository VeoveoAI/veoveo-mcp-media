{
  "db_name": "PostgreSQL",
  "query": "-- Revoke one of an artifact's share links. A link revoked earlier keeps its revocation.\nUPDATE artifact.share_link\nSET revoked_at = coalesce(revoked_at, $4)\nWHERE tenant = $1 AND share_link_id = $3 AND artifact_id = $2\nRETURNING\n    share_link_id AS \"share_link_id: ShareLinkId\",\n    artifact_id AS \"artifact_id: ArtifactId\",\n    expires_at,\n    redemption_limit,\n    redemptions,\n    revoked_at,\n    created_by,\n    created_at\n",
