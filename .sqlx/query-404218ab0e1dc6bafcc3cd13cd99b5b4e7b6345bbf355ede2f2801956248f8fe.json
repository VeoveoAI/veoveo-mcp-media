{
  "db_name": "PostgreSQL",
  "query": "-- veoveo: all tenants (a server's workers address the Tasks they run by ID, whichever tenant owns them)\n-- The owning worker asks for input; the Task waits until a caller answers.\nWITH parent AS (\n    UPDATE tasks.task\n    SET status = 'waiting', status_message = 'Waiting for input'\n    WHERE id = $1 AND server = $2 AND owner_instance = $3 AND status IN ('running', 'waiting')\n    RETURNING id\n)\nINSERT INTO tasks.task_input (task_id, request_key, kind, params)\nSELECT id, $4, $5, $6 FROM parent\nRETURNING request_key, kind, params, response, created_at, responded_at\n",
