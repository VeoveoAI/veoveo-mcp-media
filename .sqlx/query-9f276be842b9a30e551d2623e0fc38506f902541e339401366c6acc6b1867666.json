{
  "db_name": "PostgreSQL",
  "query": "-- veoveo: all tenants (a server's workers address the Tasks they run by ID, whichever tenant owns them)\n-- Request cancellation. An unowned Task has no worker to observe the request, so it\n-- is cancelled at once, unless it is parked on an operation: a claim then carries the\n-- cancellation to the provider.\nUPDATE tasks.task\nSET status = CASE\n        WHEN owner_instance IS NULL AND parked_on IS NULL THEN 'cancelled'\n        ELSE 'cancel_requested'\n    END,\n    status_message = CASE\n        WHEN owner_instance IS NULL AND parked_on IS NULL THEN 'Cancelled'\n        ELSE 'Cancelling'\n    END,\n    cancel_requested_at = now(),\n    completed_at = CASE WHEN owner_instance IS NULL AND parked_on IS NULL THEN now() END\nWHERE id = $1 AND server = $2 AND deployment = $3 AND status IN ('queued', 'running', 'waiting')\nRETURNING\n    id,\n    server,\n    deployment,\n    tenant,\n    owner_tenant,\n    owner_principal,\n    owner_kind AS \"owner_kind: PrincipalKind\",\n    owner_issuer,\n    owner_subject,\n    surface,\n    data_labels,\n    work_context,\n    authority AS \"authority: Json<InvocationAuthority>\",\n    task_type,\n    recovery_class AS \"recovery_class: RecoveryClass\",\n    input,\n    idempotency_key,\n    ttl_ms,\n    poll_interval_ms,\n    status AS \"status: TaskStatus\",\n    status_message,\n    progress,\n    result,\n    result_uri,\n    error_code,\n    error_message,\n    error_details,\n    owner_instance AS \"owner_instance: InstanceId\",\n    revision,\n    retention_pins,\n    created_at,\n    updated_at,\n    started_at,\n    cancel_requested_at,\n    completed_at,\n    retention_expires_at\n",
